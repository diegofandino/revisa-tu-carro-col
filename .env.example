# Copy to .env.local and fill in your own values. Never commit .env.local.
# Values below are fictitious placeholders.

# Supabase project URL (local: printed by `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (safe for the browser; access is enforced by RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXAMPLE_NOT_A_REAL_KEY_000000
